
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out EventPulse backend source code...'
                checkout scm
            }
        }

        stage('Backend Install') {
            steps {
                dir('server') {
                    bat 'npm ci'
                }
            }
        }

        stage('Backend Validation') {
            steps {
                dir('server') {
                    echo 'Checking backend JavaScript syntax...'
                    bat 'node --check index.js'

                    echo 'Checking installed backend dependencies...'
                    bat 'npm ls --depth=0'
                }
            }
        }

        stage('Security Audit') {
            steps {
                dir('server') {
                    bat 'npm audit --omit=dev --audit-level=high'
                }
            }
        }
    }

    post {
        success {
            echo 'EventPulse backend CI pipeline completed successfully.'
        }

        failure {
            echo 'EventPulse backend CI pipeline failed. Check the Console Output.'
        }

        always {
            echo 'Backend CI pipeline execution finished.'
        }
    }
}
